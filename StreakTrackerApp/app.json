{
  "expo": {
    "name": "StreakTracker",
    "slug": "streaktracker",
    "version": "1.6.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "streaktracker",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/56c57319-8317-4119-aa8b-d27c4c6acbd2"
    },
    "runtimeVersion": "1.6.0",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "package": "com.psydo.streaktracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "StreakTracker uses Face ID to protect your data."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a1a1a"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56c57319-8317-4119-aa8b-d27c4c6acbd2"
      }
    },
    "owner": "psydo"
  }
}
